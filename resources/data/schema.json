{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shane.logsdon.io/resources/data/schema.json",
  "title": "ArticlesListEntry",
  "description": "Schema for a single entry in articles-list.json",
  "type": "object",
  "required": ["title", "description", "date", "category"],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable article title"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "One-to-two sentence article summary shown in listings"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Publication date in YYYY-MM-DD format"
    },
    "category": {
      "type": "string",
      "enum": [
        "industry-analysis",
        "leadership-and-management",
        "strategic-insights",
        "technical-deep-dives"
      ],
      "description": "Article category (maps to /pages/articles/<category>/)"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "When true, the article is hidden from the main listing"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "description": "Topic tags used for filtering and related-article lookup"
    }
  }
}
